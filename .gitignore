# Local datasets; keep documentation and the reference manifest.
/data/*
!/data/README.md
!/data/processed/
/data/processed/*
!/data/processed/parallel/
/data/processed/parallel/*
!/data/processed/parallel/manifest.json

# Generated artifacts; keep the vocabulary index.
/artifacts/*
!/artifacts/vocabularies/
/artifacts/vocabularies/*
!/artifacts/vocabularies/index.json

# Generated translations, scores, logs and figures.
/results/figures/*
/results/metrics/*
/results/translations/*
# Saved copies of results (contain TED text, so never committed).
/results_*/

# Legacy output locations still used by older scripts/notebooks.
/out/
/outputs/
/outputs.zip
/ckpt/

