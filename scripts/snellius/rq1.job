#!/bin/bash
# RQ1 on Snellius: one array task per (run, seed). Submit from the repo root.
#
#   task:   0 none_s42   1 uk_s42   2 ru_matched_s42   3 ru_s42
#           4 none_s43   5 uk_s43   6 ru_matched_s43   7 ru_s43
#           8 none_s44   9 uk_s44  10 ru_matched_s44  11 ru_s44
#          12 tr_s42    13 tr_s43   14 tr_s44
#          15 none_az1k_s42   16 none_az1k_s43   17 none_az1k_s44
#          18 tr_az1k_s42     19 tr_az1k_s43     20 tr_az1k_s44
#
#     sbatch --array=0 scripts/snellius/rq1.job --smoke   # pipeline check first (a few minutes)
#     sbatch scripts/snellius/rq1.job                     # all 15, in parallel
#     sbatch --array=0,4-11 scripts/snellius/rq1.job      # only some of them
#
# Anything after the job file is passed to scripts/rq1_train.py. Logs: logs/rq1_<job>_<task>.out
# Runs on H100 (16 cores per GPU there). All results in the report should come from one GPU type.
#SBATCH --job-name=rq1
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --time=08:00:00
#SBATCH --array=0-20
#SBATCH --output=logs/rq1_%A_%a.out

set -euo pipefail
TASKS=("none 42" "uk 42" "ru_matched 42" "ru 42"
       "none 43" "uk 43" "ru_matched 43" "ru 43"
       "none 44" "uk 44" "ru_matched 44" "ru 44"
       "tr 42"   "tr 43"  "tr 44"
       "none_az1k 42" "none_az1k 43" "none_az1k 44"
       "tr_az1k 42"   "tr_az1k 43"   "tr_az1k 44")
read -r RUN SEED <<< "${TASKS[$SLURM_ARRAY_TASK_ID]}"

module purge
module load 2024
module load Python/3.12.3-GCCcore-13.3.0
source .venv/bin/activate

export HF_HUB_OFFLINE=1          # model was cached by setup.sh
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

echo "run=$RUN seed=$SEED node=$(hostname) start=$(date)"
# Checkpoints (~15 GB per run) go to the node's own scratch disk, which Snellius wipes when the job
# ends: home is too small for 15 parallel runs. Only translations and scores land in results/.
python scripts/rq1_train.py --run "$RUN" --seed "$SEED" --ckpt-root "${TMPDIR:?TMPDIR not set}" "$@"
echo "end=$(date)"
